{
  "name": "cuestack",
  "productName": "CueStack",
  "version": "1.5.1",
  "description": "Kostenloser Show-Cue-Helfer: Timer, Folien, PowerPoint, Dokumente, Lyrics, Referentenansicht, Stage-Monitor, Capture, Mix – Ausgabe als Fenster/Vollbild und NDI.",
  "main": "desktop/main.js",
  "author": "Sebastian Hellfritz",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@stagetimerio/grandiose": "0.2.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.sstgame.cuestack",
    "productName": "CueStack",
    "copyright": "Sebastian Hellfritz",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "web/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/@stagetimerio/grandiose/dist/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CueStack-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CueStack"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "CueStack-${version}-Mac-AppleSilicon.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "CueStack steuert Keynote, Pages oder Numbers, um Präsentationen und Dokumente in PDF umzuwandeln.",
        "NSScreenCaptureUsageDescription": "CueStack braucht die Bildschirmaufnahme für die Desktop-Capture-Slots."
      }
    }
  }
}
